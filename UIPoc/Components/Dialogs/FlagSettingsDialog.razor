@inject DialogService DialogService

<RadzenStack Gap="1rem" Style="padding: 1rem;">
    <RadzenFormField Text="Flag Min Value" Style="width: 100%;">
        <RadzenNumeric @bind-Value="@FlagMinValue" 
                       Style="width: 100%;" 
                       Placeholder="Enter minimum flag value"
                       TValue="decimal?" />
    </RadzenFormField>

    <RadzenFormField Text="Flag Max Value" Style="width: 100%;">
        <RadzenNumeric @bind-Value="@FlagMaxValue" 
                       Style="width: 100%;" 
                       Placeholder="Enter maximum flag value"
                       TValue="decimal?" />
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" />
        <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter]
    public decimal? FlagMinValue { get; set; }

    [Parameter]
    public decimal? FlagMaxValue { get; set; }

    private async Task Save()
    {
        DialogService.Close((FlagMinValue, FlagMaxValue));
        await Task.CompletedTask;
    }

    private async Task Cancel()
    {
        DialogService.Close(null);
        await Task.CompletedTask;
    }
}
